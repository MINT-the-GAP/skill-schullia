  "macros": {
    "Highscore": {
      "syntax": "@Highscore(base_points, failed_check_penalty, hint_penalty, grace_minutes, per_minute_penalty)",
      "arity": 5,
      "constraints": ["base_points > 0", "all_other_values >= 0"],
      "placement": "first_slide",
      "final_score": "max(0, base_points - penalties) + remaining_gold * gold_score_value + remaining_diamonds * diamond_score_value",
      "base_points_are_upper_bound": false,
      "perfect_highscore_achievement_uses": "base_score_before_resource_bonus"
    },
    "Ressourcen": {
      "syntax": "@Ressourcen(gold, diamonds[, energy][, diamantwert=value][, goldwert=value])",
      "arity": [2, 5],
      "runtime_values": "nonnegative_numbers_rounded_down",
      "generation_values": "nonnegative_integers",
      "first_valid_source_declaration_wins": true,
      "named_score_options": {
        "goldwert": {"default": 100, "minimum": 0, "finite": true},
        "diamantwert": {"default": 250, "minimum": 0, "finite": true},
        "order": "arbitrary_after_resource_values",
        "semicolon_grouping": true,
        "energy_score_value": 0
      }
    },
    "achievements": {
